# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Storage target ────────────────────────────────────────────────────────────
# Controls the Delta Lake export destination (Silver/Gold layer output).
# "local"   — write to LOCAL_STORAGE_PATH on disk (no credentials needed)
# "s3"      — write to S3-compatible storage (requires S3_BUCKET_DELTA + S3 creds)
# "onelake" — write to Microsoft Fabric OneLake (requires Azure service principal)
STORAGE_TARGET=local
LOCAL_STORAGE_PATH="/path/to/repo/data"
DANISH_DEMOCRACY_DATA_SOURCE="/path/to/repo/data/Files/Bronze/DDD"

# ── Source systems ────────────────────────────────────────────────────────────
DANISH_DEMOCRACY_BASE_URL="https://oda.ft.dk/api"
# Number of days to look back for incremental DDD loads (default: 31)
DANISH_DEMOCRACY_DEFAULT_DAYS_TO_LOAD=31

# Rfam public MySQL database (read-only, no password needed)
RFAM_CONNECTION_STRING="mysql+pymysql://rfamro@mysql-rfam-public.ebi.ac.uk:4497/Rfam"
RFAM_DATA_SOURCE="/path/to/repo/data/Files/Bronze/RFAM"
RFAM_DEFAULT_DAYS_TO_LOAD=365

# ── Dagster ───────────────────────────────────────────────────────────────────
# Dagster home directory — the Docker volume path used by the running container.
# Also used as the backup source by backup_platform / restore_platform.
DAGSTER_HOME="/data/dagster"

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_FRESHNESS_WARN_AFTER_DAYS=2
DBT_FRESHNESS_ERROR_AFTER_DAYS=7
DBT_PROJECT_DIRECTORY="/path/to/repo/dbt"
DBT_MODELS_DIRECTORY="/path/to/repo/dbt/models"
DBT_LOGS_DIRECTORY="/path/to/repo/dbt/logs"

# ── dlt ───────────────────────────────────────────────────────────────────────
DLT_PIPELINES_DIR="/path/to/repo/dlt/pipelines_dir"

# Pipeline run log root directory (default: LOCAL_STORAGE_PATH/logs).
# Each source system appends its own sub-directory: <DLT_PIPELINE_RUN_LOG_DIR>/<source>/<pipeline>/.
#DLT_PIPELINE_RUN_LOG_DIR=data/logs

# ── DuckDB ────────────────────────────────────────────────────────────────────
# Default: duckdb/danish_democracy_data.duckdb (relative to working directory).
DUCKDB_DATABASE_LOCATION="/path/to/repo/duckdb/danish_democracy_data.duckdb"
DUCKDB_DATABASE=danish_democracy_data

# Silver layer storage format (independent of STORAGE_TARGET).
# "duckdb"   — silver tables are native DuckDB tables (default)
# "ducklake" — silver tables are DuckLake-managed Parquet files stored locally
#              under DUCKLAKE_CATALOG_LOCATION; selects the "local_ducklake"
#              dbt target regardless of STORAGE_TARGET.
SILVER_STORAGE_FORMAT=duckdb

# Required only when SILVER_STORAGE_FORMAT=ducklake.
# Path to the DuckLake catalog database file (a DuckDB database; the catalog and
# its data directory are auto-created on first attach). Keep it separate from the
# main DUCKDB_DATABASE_LOCATION file.
DUCKLAKE_CATALOG_LOCATION="/data/duckdb/ducklake_catalog.ducklake"
# Directory where DuckLake stores its Parquet data files.
DUCKLAKE_DATA_PATH="/data/ducklake"

# ── Raw (Bronze + DuckLake) S3 storage ───────────────────────────────────────
# RAW_STORAGE_TARGET controls where internal data lives: Bronze raw files
# written by dlt and DuckLake Silver Parquet files.  Independent of
# STORAGE_TARGET (Delta Lake export destination) — these files are never on
# OneLake.
#   local — local disk under LOCAL_STORAGE_PATH (default)
#   s3    — S3-compatible storage (MinIO locally, AWS S3 in production)
RAW_STORAGE_TARGET=local

# S3 credentials — shared between RAW_STORAGE_TARGET=s3 and STORAGE_TARGET=s3.
# Required when either switch is "s3".
# MinIO (local dev): set S3_ENDPOINT, S3_USE_SSL=false, S3_URL_STYLE=path.
# AWS S3 (production): omit S3_ENDPOINT (leave empty), S3_USE_SSL=true, S3_URL_STYLE=vhost.
# WARNING: MinIO requires URL_STYLE=path — omitting it causes 400 errors.
#
# CRITICAL: S3 buckets must exist before first use. Create them:
#   MinIO: Use the console at http://localhost:9001 or mc CLI (see docker-compose.minio.yml)
#   AWS S3: Use the AWS console or:  aws s3 mb s3://ddd-bronze --region us-east-1
#S3_ENDPOINT=http://minio:9000
#S3_ACCESS_KEY_ID=minioadmin
#S3_SECRET_ACCESS_KEY=minioadmin
#S3_REGION=us-east-1
#S3_USE_SSL=false
#S3_URL_STYLE=path

# Vars for RAW_STORAGE_TARGET=s3 (Bronze files + DuckLake Parquet):
#S3_BUCKET_BRONZE=ddd-bronze
#S3_PREFIX_BRONZE=
#S3_BUCKET_DUCKLAKE=ddd-ducklake
#S3_PREFIX_DUCKLAKE=

# Vars for STORAGE_TARGET=s3 (Delta Lake export destination):
#S3_BUCKET_DELTA=ddd-delta
#S3_PREFIX_DELTA=

# When RAW_STORAGE_TARGET=s3, update data source paths to S3 URIs.
# dlt writes files under Files/Bronze/<source>/ inside the bucket, so the
# data source path must include that prefix:
#DANISH_DEMOCRACY_DATA_SOURCE=s3://ddd-bronze/Files/Bronze/DDD
#RFAM_DATA_SOURCE=s3://ddd-bronze/Files/Bronze/RFAM
# If S3_PREFIX_BRONZE is set (e.g. "raw"), adjust accordingly:
#DANISH_DEMOCRACY_DATA_SOURCE=s3://ddd-bronze/raw/Files/Bronze/DDD

# ── Docker: DANISH_DEMOCRACY_DATA_SOURCE / RFAM_DATA_SOURCE overrides ────────
# docker-compose.yml overrides these two vars for containers to the
# /data/local mount (matching RAW_STORAGE_TARGET=local) by default, since the
# plain values above are host-absolute paths that don't exist inside the
# container. If you run Docker with RAW_STORAGE_TARGET=s3, set these instead
# so the S3 URIs reach the container unchanged:
#DANISH_DEMOCRACY_DATA_SOURCE_DOCKER=s3://ddd-bronze/Files/Bronze/DDD
#RFAM_DATA_SOURCE_DOCKER=s3://ddd-bronze/Files/Bronze/RFAM

# When RAW_STORAGE_TARGET=s3 and SILVER_STORAGE_FORMAT=ducklake, DuckLake
# Parquet data is automatically stored on S3 — DUCKLAKE_DATA_PATH is derived
# from S3_BUCKET_DUCKLAKE + S3_PREFIX_DUCKLAKE; do NOT set it manually in S3 mode.
# The .ducklake catalog file always stays local at DUCKLAKE_CATALOG_LOCATION.
# Switching to S3-backed DuckLake requires a Silver full-refresh:
#   dbt build --select tag:silver --full-refresh

# ── Azure AD service principal ────────────────────────────────────────────────
# Required for OneLake access and Fabric capacity management.
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-azure-subscription-id>
AZURE_RESOURCE_GROUP="<your-resource-group>"
AZURE_CLIENT_ID=<your-app-client-id>
AZURE_CLIENT_SECRET=<your-app-client-secret>

# ── Docker ────────────────────────────────────────────────────────────────────
# GID of the Docker socket on the host — needed by the dagster and backup
# containers so the non-root app user (UID 1000) can reach the socket.
# Find the right value with:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Host path to SSH keys mounted read-only into the backup container.
# The backup service mounts this directory at /home/app/.ssh inside the container.
# Defaults to /root/.ssh when not set (common on Hetzner servers running as root).
HOST_SSH_DIR=/root/.ssh

# ── Backup ───────────────────────────────────────────────────────────────────
# Used by ddd_python.ddd_utils.backup_platform and restore_platform.
# ENVIRONMENT determines the StorageBox subdirectory: backups/ddd/dev or backups/ddd/prod
ENVIRONMENT=DEV

# ── Alerting ──────────────────────────────────────────────────────────────────
# ntfy.sh topic for Dagster run alerts (success + failure).
# Set to the topic name only — do NOT include the ntfy.sh/ URL prefix.
# Leave unset to disable push notifications.
NTFY_TOPIC=your-topic-name

# Local directories where zip archives are stored (created automatically on first run).
DAGSTER_BACKUP_DIR="/data_backup/dagster"
METABASE_BACKUP_DIR="/data_backup/metabase"
DUCKDB_BACKUP_DIR="/data_backup/duckdb"
# DuckLake Parquet data files (only used when SILVER_STORAGE_FORMAT=ducklake).
DUCKLAKE_BACKUP_DIR="/data_backup/ducklake"
BACKUP_LOG_DIR="/data_backup/logs"
# Each run writes its own log: backup_log_YYYYMMDD_HHMMSS.ndjson
# Query all runs: SELECT * FROM read_json_auto('/data_backup/logs/backup_log_*.ndjson');

# Retention: local archives older than this many days are deleted after each successful backup.
DAGSTER_BACKUP_MAX_AGE_DAYS=62
METABASE_BACKUP_MAX_AGE_DAYS=62
DUCKDB_BACKUP_MAX_AGE_DAYS=7
# DuckLake data files share the duckdb retention (the catalog rides along in the duckdb target).
DUCKLAKE_BACKUP_MAX_AGE_DAYS=7

# Source directory to archive for Metabase (Docker volume path — do not change unless volumes move).
# DAGSTER_HOME above serves as the Dagster backup source.
METABASE_DATA_DIR="/data/metabase/data"

# Seconds to wait after stopping containers so databases can flush to disk (default: 30).
# Set to 0 for local/dev runs to skip the wait.
# FLUSH_WAIT_SECONDS=30

# ── Hetzner StorageBox (optional — upload skipped when HOST or USER is absent) ──
# SSH port for Hetzner StorageBox is always 23, not 22.
HETZNER_STORAGEBOX_HOST="u123456.your-storagebox.de"
HETZNER_STORAGEBOX_USER="u123456"
HETZNER_STORAGEBOX_PORT=23
# Archives are uploaded to <REMOTE_DIR>/<ENVIRONMENT>/  (e.g. backups/ddd/prod/)
HETZNER_STORAGEBOX_REMOTE_DIR="backups/ddd"
# Optional: path to the SSH private key inside the container (/home/app/.ssh/ is
# where HOST_SSH_DIR is mounted).  Omit to use the default key in that directory.
# HETZNER_STORAGEBOX_SSH_KEY="/home/app/.ssh/id_ed25519_storagebox"
# Remote retention (grandfather-father-son): keep the most recent N daily and M
# monthly archives per target on the StorageBox; older ones are pruned after each
# upload.  Defaults below; set both to 0 to keep everything remotely.
# HETZNER_STORAGEBOX_KEEP_DAILY=31
# HETZNER_STORAGEBOX_KEEP_MONTHLY=12

# ── Microsoft Fabric / OneLake ────────────────────────────────────────────────
FABRIC_CAPACITY_NAME="<your-fabric-capacity-name>"
FABRIC_WORKSPACE=<your-fabric-workspace-name>
FABRIC_ONELAKE_STORAGE_ACCOUNT=onelake
# Optional: local mount point for OneLake (e.g. via OneLake file explorer)
FABRIC_ONELAKE_MOUNT="/path/to/onelake/mount"
# OneLake folder paths (relative to workspace)
FABRIC_ONELAKE_FOLDER_BRONZE=<Workspace>.Lakehouse/Files/Bronze
FABRIC_ONELAKE_FOLDER_SILVER=<Workspace>.Lakehouse/Files/Silver
FABRIC_ONELAKE_FOLDER_GOLD=<Workspace>.Lakehouse/Files/Gold
